DB_HOST=127.0.0.1
DB_NAME=painting_marketplace
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4

# Production frontend origins. Keep localhost entries for local development if needed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://arts.araha.co.in,https://artsadmin.araha.co.in
ALLOWED_ADMIN_ORIGINS=http://localhost:5174,https://artsadmin.araha.co.in

# Session settings for same-site subdomains. Leave blank for host-only cookies if preferred.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax

# Local SMTP on the same server. Use the credentials/port supplied by the hosting mail service.
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
